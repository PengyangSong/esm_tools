#!/usr/bin/ksh

#
# Wetdry FESOM → ice-sheet ocean boundary file.
#
# Expects annual FESOM cavity-interface files (monthly time axis inside each file is fine):
#   cavity_Tsurf.fesom.<year>.nc
#   cavity_Ssurf.fesom.<year>.nc
#   cavity_Bmelt.fesom.<year>.nc
#
# Workflow: unstructured → (time,horizontal) + lon/lat aux (fesom_scalar_array_to_LonLat.py),
# merge into ocean_file_for_ice.nc. Annual / temporal collapse for PISM is done in
# coupling_ocean2pism.functions (timmean).
#

function fesom2ice {
    FESOM_TO_ISM_ocean_forcing=${FESOM_TO_ISM_ocean_forcing:-0}
    echo " *** S T A R T I N G    fesom2ice (cavity-interface, wetdry) *** "

    . ${FUNCTION_PATH}/../general/general_lists.functions
    . ${FUNCTION_PATH}/../general/coupling_general.functions

    echo "     Starting coupling_fesom2ice.functions (cavity path) ...."
    echo "FESOM_TO_ISM_ocean_forcing=${FESOM_TO_ISM_ocean_forcing}"

    fesom_ice_prepare_ocean_for_pism
    fesom_ice_write_ocean_griddes
    fesom_ice_write_ocean_names

    for file in ${cleanup_list} ; do test -f $file && rm $file ; done
    unset cleanup_list file
}

function fesom_ice_prepare_ocean_for_pism {
    echo "Preparing ocean_file_for_ice.nc from FESOM cavity-interface fields..."

    fesom_ice_construct_input_list
    fesom_ice_remap_cavity_lonlat
    fesom_ice_concatenate_files

    cp $(pwd)/ocean_file_for_ice.nc ${COUPLE_DIR}/ocean_file_for_ice.nc

    if [ "${MACHINE}" == "albedo" ]; then
        module unload python
        module load python
    fi

    echo "     ...done."
}

function fesom_ice_write_ocean_griddes {
    echo "Writing ocean grid description to generic ocean.griddes..."
    echo ""; echo " *   generating griddes"
    NEW_OCE2ICE_GRID=$(build_grid_des ocean_file_for_ice.nc ocean.griddes couple)
    export NEW_OCE2ICE_GRID
    cp $(pwd)/ocean.griddes ${COUPLE_DIR}/ocean.griddes
    echo "....done."
}

function fesom_ice_write_ocean_names {
    echo "Writing ocean_names_for_ice.dat (for read_names ocean→ice)"
    :> ocean_names_for_ice.dat
    echo "" ; echo " *   cavity → Tsurf → shelfbtemp"
    echo "ocean_name_pot_temperature_z0=Tsurf" >> ocean_names_for_ice.dat
    echo "ocean_units_pot_temperature_z0=degC" >> ocean_names_for_ice.dat
    echo "" ; echo " *   cavity → Ssurf"
    echo "ocean_name_salinity_z0=Ssurf" >> ocean_names_for_ice.dat
    echo "ocean_units_salinity_z0=g/kg" >> ocean_names_for_ice.dat
    echo "" ; echo " *   cavity_Bmelt → fw → shelfbmassflux"
    echo "ocean_name_fwflux_z0=fw" >> ocean_names_for_ice.dat
    echo "ocean_units_fwflux_z0=kg/m2" >> ocean_names_for_ice.dat
    echo "" ; echo " *   iter (if present)"
    echo "ocean_name_iter=iter" >> ocean_names_for_ice.dat
    echo "ocean_units_iter=1" >> ocean_names_for_ice.dat
    cp $(pwd)/ocean_names_for_ice.dat ${COUPLE_DIR}/ocean_names_for_ice.dat
    echo "     ...done."
}

function fesom_ice_construct_input_list {
    echo ""; echo " *   checking cavity-interface inputs per year"

    export CHUNK_END_YEAR_fesom=$(date -d "${CHUNK_END_DATE_fesom:?'Missing variable'}" +%Y)
    export CHUNK_END_MONTH_fesom=$(date -d "${CHUNK_END_DATE_fesom:?'Missing variable'}" +%m)
    export CHUNK_END_DAY_fesom=$(date -d "${CHUNK_END_DATE_fesom:?'Missing variable'}" +%d)

    number_of_years_for_forcing=${number_of_years_for_forcing:-1}
    start_year_couple=$(( CHUNK_END_YEAR_fesom - number_of_years_for_forcing + 1 ))
    end_year_couple=${CHUNK_END_YEAR_fesom}
    export start_year_couple end_year_couple

    for year in $(seq $start_year_couple $end_year_couple ); do
        for v in cavity_Tsurf cavity_Ssurf cavity_Bmelt ; do
            _f=${DATA_DIR_fesom}/${v}.fesom.${year}.nc
            if [ ! -f "${_f}" ] ; then
                echo "     - Missing required cavity file ${_f}"
                echo " S T O P  (coupling_fesom2ice.functions::fesom_ice_construct_input_list)" ; exit 1
            fi
        done
    done
    echo "     - cavity T/S/Bmelt present for years ${start_year_couple}–${end_year_couple}"
    unset _f v year
}

function fesom_ice_remap_cavity_lonlat {
    if [ "${MACHINE}" == "levante" ]; then
        module load python3
    fi
    echo ""; echo " *   cavity fields → lon/lat (python $(python --version 2>&1))"

    pyfesom_script=${FUNCTION_PATH:-${FPATH}}/../utils/fesom_scalar_array_to_LonLat.py
    if [ ! -f $pyfesom_script ] ; then
        echo "     - Missing ${pyfesom_script}"
        echo " S T O P  (coupling_fesom2ice.functions::fesom_ice_remap_cavity_lonlat)" ; exit 5
    fi

    PYFESOM_PATH=${PYFESOM_PATH:-${FUNCTION_PATH}/pyfesom}
    CMOCEAN_PATH=${CMOCEAN_PATH:-${FUNCTION_PATH}/cmocean}
    for dir in ${PYFESOM_PATH} ${CMOCEAN_PATH} ; do
        base_dir=$(basename $dir)
        if [ ! -d $base_dir ] ; then
            ln -s $dir
        fi
    done

    if [ "${MACHINE}" == "albedo" ]; then
        module unload python
        module load python/3.9.12
    fi

    processed_fesom_ice_Tsurf=""
    processed_fesom_ice_Ssurf=""
    processed_fesom_ice_fw=""

    # Tsurf
    out_T=ocean_ice_Tsurf_lonlat_${start_year_couple}_${end_year_couple}.nc
    log_T=${out_T%.nc}.log
    echo -n "     - Tsurf (cavity_Tsurf) → ${out_T}"
    python $pyfesom_script ${FESOM_MESH_SWITCHES} \
        --FESOM_PATH "${DATA_DIR_fesom}/" \
        --FESOM_VARIABLE cavity_Tsurf \
        --FESOM_MESH ${MESH_DIR_fesom} \
        --FESOM_YEARS $start_year_couple $end_year_couple \
        --FESOM_MESH_ROTATED ${MESH_ROTATED_fesom} \
        --FESOM_OUTPUT $out_T > $log_T
    if ncdump -h $out_T 2>/dev/null | grep -q "cavity_Tsurf" ; then
        ncrename -v cavity_Tsurf,Tsurf $out_T || exit 6
    fi
    test_file_or_exit $out_T 6
    processed_fesom_ice_Tsurf=$out_T
    echo " : ok"

    # Ssurf
    out_S=ocean_ice_Ssurf_lonlat_${start_year_couple}_${end_year_couple}.nc
    log_S=${out_S%.nc}.log
    echo -n "     - Ssurf (cavity_Ssurf) → ${out_S}"
    python $pyfesom_script ${FESOM_MESH_SWITCHES} \
        --FESOM_PATH "${DATA_DIR_fesom}/" \
        --FESOM_VARIABLE cavity_Ssurf \
        --FESOM_MESH ${MESH_DIR_fesom} \
        --FESOM_YEARS $start_year_couple $end_year_couple \
        --FESOM_MESH_ROTATED ${MESH_ROTATED_fesom} \
        --FESOM_OUTPUT $out_S > $log_S
    if ncdump -h $out_S 2>/dev/null | grep -q "cavity_Ssurf" ; then
        ncrename -v cavity_Ssurf,Ssurf $out_S || exit 7
    fi
    test_file_or_exit $out_S 7
    processed_fesom_ice_Ssurf=$out_S
    echo " : ok"

    # fw (basal melt) — optional GLAC_flag mask via mesh_cst.nc
    out_fw=ocean_ice_fw_lonlat_${start_year_couple}_${end_year_couple}.nc
    log_fw=${out_fw%.nc}.log
    _fesom_path_for_fw="${DATA_DIR_fesom}/"
    _fw_y0=$start_year_couple
    _fw_y1=$end_year_couple
    _mesh_cst="${MESH_DIR_fesom}/mesh_cst.nc"
    if [[ -f "${_mesh_cst}" ]] && ncdump -h "${_mesh_cst}" 2>/dev/null | grep -q "GLAC_flag"; then
        _fw_tmp_dir="${COUPLE_DIR}/fw_glac_mask_${start_year_couple}_${end_year_couple}_$$"
        mkdir -p "${_fw_tmp_dir}" || exit 1
        echo ""
        echo "     + masking cavity_Bmelt with GLAC_flag from ${_mesh_cst} (years ${start_year_couple}–${end_year_couple})"
        for _yy in $(seq ${start_year_couple} ${end_year_couple}); do
            _fw_src="${DATA_DIR_fesom}/cavity_Bmelt.fesom.${_yy}.nc"
            _fw_masked="${_fw_tmp_dir}/cavity_Bmelt.fesom.${_yy}.nc"
            if [[ ! -f "${_fw_src}" ]]; then
                echo "     ERROR: missing ${_fw_src} for GLAC_flag masking"
                echo " S T O P  (coupling_fesom2ice.functions::fesom_ice_remap_cavity_lonlat)" ; exit 9
            fi
            $cdo -O ifthen -selvar,GLAC_flag "${_mesh_cst}" -selvar,cavity_Bmelt "${_fw_src}" "${_fw_masked}" || exit 1
            cleanup_list="${cleanup_list} ${_fw_masked}"
        done
        _fesom_path_for_fw="${_fw_tmp_dir}/"
    fi
    echo -n "     - fw (cavity_Bmelt) → ${out_fw}"
    python $pyfesom_script ${FESOM_MESH_SWITCHES} \
        --FESOM_PATH "${_fesom_path_for_fw}" \
        --FESOM_VARIABLE cavity_Bmelt \
        --FESOM_MESH ${MESH_DIR_fesom} \
        --FESOM_YEARS $_fw_y0 $_fw_y1 \
        --FESOM_MESH_ROTATED ${MESH_ROTATED_fesom} \
        --FESOM_OUTPUT $out_fw > $log_fw
    if ncdump -h $out_fw 2>/dev/null | grep -q "cavity_Bmelt" ; then
        ncrename -v cavity_Bmelt,fw $out_fw || exit 8
    fi
    test_file_or_exit $out_fw 8
    processed_fesom_ice_fw=$out_fw
    echo " : ok"

    export processed_fesom_ice_Tsurf processed_fesom_ice_Ssurf processed_fesom_ice_fw
    cleanup_list="${cleanup_list} $(pwd)/${processed_fesom_ice_Tsurf} $(pwd)/${processed_fesom_ice_Ssurf} $(pwd)/${processed_fesom_ice_fw}"

    unset dir base_dir pyfesom_script out_T out_S out_fw log_T log_S log_fw
    unset _fesom_path_for_fw _fw_y0 _fw_y1 _fw_src _mesh_cst _fw_tmp_dir _fw_masked _yy
    unset FESOM_MESH_SWITCHES
}

function fesom_ice_concatenate_files {
    echo ""; echo " *   merge Tsurf, Ssurf, fw → ocean_file_for_ice.nc"
    [[ -f ocean_file_for_ice.nc ]] && rm ocean_file_for_ice.nc

    ${cdo} -s merge \
        "${processed_fesom_ice_Tsurf}" \
        "${processed_fesom_ice_Ssurf}" \
        "${processed_fesom_ice_fw}" \
        ocean_file_for_ice.nc

    unset processed_fesom_ice_Tsurf processed_fesom_ice_Ssurf processed_fesom_ice_fw
}
