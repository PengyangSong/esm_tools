# Copy this file to a private location, source it before an esm_tools run, or
# translate the same values into fesom.wetdry_* runscript settings.
# Paths below are examples; do not commit personal paths to a shared runscript.

export WETDRY_RUNTIME_ROOT=/path/to/user/work/test
export WETDRY_MESHTOOLS_BIN="${WETDRY_RUNTIME_ROOT}/meshtools_triangle/bin"
export WETDRY_FESOM_INI="${WETDRY_RUNTIME_ROOT}/bin/fesom_ini.x"
export R_LIBS_USER="${WETDRY_RUNTIME_ROOT}/libs"
export RSCRIPT=Rscript
export WETDRY_PYTHON=python3

# These are experiment/data paths and must be supplied separately.
export WETDRY_QGLB_DIR=/path/to/CORE3_QGLB
export WETDRY_PRIORITY_NODES=/path/to/priority_nodes.PISM.txt
export PYFESOM_PATH=/path/to/pyfesom2
